# API Keys for Stock Tracker
# Copy this file to .env and fill in your actual API keys.
# On Netlify, add the same variables under Site configuration → Environment variables.
# The keys are only read server-side (netlify/functions/api.mjs) and never
# shipped to the browser. The older VITE_-prefixed names still work too.

# Finnhub API Key - Get yours at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Twelve Data API Key - Get yours at https://twelvedata.com/ (used for price alerts)
TWELVE_DATA_KEY=your_twelve_data_api_key_here

# Polygon API Key - Get yours at https://polygon.io/ (used for market status / holidays)
POLYGON_API_KEY=your_polygon_api_key_here

# NewsAPI Key - Get yours at https://newsapi.org/ (free tier: 100 calls/day)
NEWSAPI_KEY=your_newsapi_key_here
