# API Keys for Stock Tracker
# Copy this file to .env and fill in your actual API keys

# Finnhub API Key - Get yours at https://finnhub.io/
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Twelve Data API Key - Get yours at https://twelvedata.com/
VITE_TWELVE_DATA_KEY=your_twelve_data_api_key_here

# Polygon API Key - Get yours at https://polygon.io/ (used for market status)
VITE_POLYGON_API_KEY=your_polygon_api_key_here

# NewsAPI Key - Get yours at https://newsapi.org/ (free tier: 100 calls/day)
VITE_NEWSAPI_KEY=your_newsapi_key_here
